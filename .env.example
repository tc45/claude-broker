# Claude Broker environment â€” copy to .env and fill in values.
# NEVER commit real tokens.

# Required: subscription OAuth token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Required when binding to non-loopback (default in Docker)
BROKER_AUTH_TOKEN=

# Transport
BROKER_TRANSPORT=http
BROKER_HOST=127.0.0.1
BROKER_PORT=8787

# Workspace and state
BROKER_WORKSPACE_ROOTS=/workspace
BROKER_STATE_DIR=/var/lib/claude-broker

# Policy
BROKER_DEFAULT_POLICY=reviewed
BROKER_POLICY_FILE=policies/default.yaml

# Limits
BROKER_MAX_SESSIONS=8
BROKER_DEFAULT_BUDGET_USD=2.00
BROKER_GLOBAL_BUDGET_USD=50.00
BROKER_SESSION_IDLE_TTL=3600

# Billing guard escape hatch (NOT recommended)
BROKER_ALLOW_API_BILLING=0

# Explicitly blank API keys to prevent hijacking
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Dev: skip live auth probe during tests
BROKER_SKIP_AUTH_PROBE=0
# Windows / Docker Desktop: put CLAUDE_CODE_OAUTH_TOKEN and BROKER_AUTH_TOKEN in this file only.
# Avoid docker-compose file secrets on Windows — Docker bind-mounts those paths and can leave empty
# directories on the host instead of files, which blocks creating the secret file (Access denied).

